{
  "$schema_name": "WickedGarden.StateBoard",
  "version": "1.0.0-design",
  "description": "Canonical shared state for GM Agent + Sophia Agent. Source of truth over chat memory. Design-phase contract — not runtime code.",
  "conventions": {
    "flag_names": "snake_case",
    "booleans_default": false,
    "meters_range": [0, 100],
    "enums_exhaustive": true,
    "unknown_flags": "reject_or_namespace_mod",
    "time": {
      "garden_day_index": "integer >= 0",
      "time_debt_mortal_days": "garden days completed * 10 + fractional shards",
      "formula_note": "1 Garden day = 10 mortal days"
    }
  },
  "meta": {
    "session_id": { "type": "string", "owner": "system" },
    "player": {
      "name": { "type": "string", "default": "you" },
      "pronouns": { "type": "string", "examples": ["they/them", "she/her", "he/him"] },
      "background_tags": {
        "type": "string[]",
        "examples": ["artist", "scholar", "lost_traveler", "runaway_spouse", "occult_dabbler"]
      },
      "boundaries": {
        "hard_nos": { "type": "string[]", "owner": "product", "above_agents": true },
        "soft_nos": { "type": "string[]" },
        "green_lights": { "type": "string[]" }
      }
    },
    "content": {
      "intensity": {
        "type": "enum",
        "values": ["suggestive", "explicit", "extreme"],
        "default": "suggestive",
        "owner": "product"
      },
      "fade_available": { "type": "boolean", "default": true },
      "aftercare_mode": { "type": "boolean", "default": false },
      "reduced_motion": { "type": "boolean", "default": false },
      "analyst_mode": { "type": "boolean", "default": false, "description": "Show raw meter numbers" }
    },
    "act": {
      "type": "enum",
      "values": ["prologue", "act1", "act2", "act3", "finale", "epilogue"],
      "default": "prologue"
    },
    "garden_day_index": { "type": "integer", "default": 0 },
    "location_key": {
      "type": "enum",
      "values": [
        "mortal_threshold",
        "gate_of_briars",
        "path_first_petals",
        "guest_house",
        "heart_grove",
        "feasting_glade",
        "mirror_pools",
        "thorn_labyrinth",
        "winter_spindle",
        "root_crypts",
        "briar_deep",
        "aviary_unsent",
        "night_market",
        "unknown"
      ]
    },
    "garden_season": {
      "type": "enum",
      "values": ["bloom", "thorn", "harvest", "hush"],
      "default": "bloom"
    }
  },
  "meters": {
    "favor": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 15,
      "ui": "rose_bloom",
      "description": "Sophia's favor / obsession heat toward player",
      "write": ["gm_agent", "sophia_agent", "system"]
    },
    "autonomy": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 70,
      "ui": "vine_hands",
      "description": "Player will / bargaining power"
    },
    "corruption": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 5,
      "ui": "gold_dust",
      "description": "Fae-touched / Garden-bound"
    },
    "knowledge": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 0,
      "ui": "moth_eye",
      "description": "Laws, secrets, dangerous awareness"
    },
    "time_debt_mortal_days": {
      "type": "number",
      "min": 0,
      "default": 0,
      "ui": "ash_hourglass",
      "description": "Mortal days lost equivalent"
    },
    "desire": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 10,
      "ui": "heat_shimmer",
      "description": "Optional explicit track; hunger/attraction pressure"
    },
    "equality_seed": {
      "type": "integer",
      "min": 0,
      "max": 10,
      "default": 0,
      "description": "Progress toward E2 peer path"
    },
    "labyrinth_lost": {
      "type": "integer",
      "min": 0,
      "max": 3,
      "default": 0,
      "description": "Hidden Day 5 lost meter"
    }
  },
  "clocks": {
    "ashen_pressure": { "type": "integer", "min": 0, "max": 5, "default": 0 },
    "briar_hunger": { "type": "integer", "min": 0, "max": 5, "default": 0 },
    "sophia_break": { "type": "integer", "min": 0, "max": 5, "default": 0 },
    "mortal_collapse": { "type": "integer", "min": 0, "max": 5, "default": 0 },
    "notes": "At 5 force setpiece; Day 7+ primary"
  },
  "knowledge_partitions": {
    "public_world": {
      "owner": ["gm_agent", "sophia_agent"],
      "description": "Shared facts both may use freely"
    },
    "sophia_private": {
      "owner": ["sophia_agent"],
      "description": "Her true motives, soft century guilt detail, private desire plans"
    },
    "gm_secrets": {
      "owner": ["gm_agent"],
      "description": "Briar full truth, ending keys, NPC private plots"
    },
    "player_facing": {
      "owner": ["system"],
      "description": "What has been shown in prose/UI"
    }
  },
  "relationships": {
    "schema": {
      "stance": {
        "type": "enum",
        "values": [
          "unknown",
          "curious",
          "interested_possessive",
          "allied",
          "wary_respect",
          "hostile",
          "hostile_interest",
          "amused_predator",
          "in_love_peer",
          "thrall_bond",
          "creditor",
          "dead_or_gone"
        ]
      },
      "trust": { "type": "integer", "min": 0, "max": 100 },
      "debt_to_them": { "type": "integer", "min": 0, "max": 100 },
      "secrets_shared": { "type": "string[]" }
    },
    "npcs": [
      "sophia",
      "ashen_vale",
      "thornwake",
      "lior",
      "mother_briar",
      "elias",
      "mara_quill",
      "bloomkin_generic",
      "court_generic"
    ]
  },
  "inventory": {
    "item_ids": [
      "collar_soft_thorns",
      "thorn_ring",
      "kiss_petal",
      "nightbloom_wine",
      "living_silk",
      "salt_circle_chalk",
      "iron_pin",
      "ashen_clasp",
      "ashen_passport",
      "briar_key",
      "mortalslip_thread",
      "lovers_ring_cold",
      "pressed_letter",
      "black_honey",
      "seed_of_becoming",
      "mirror_glass_knife",
      "mirror_chip",
      "thorn_of_proof",
      "frost_splinter",
      "true_name_shard_sophia_partial",
      "pressed_court_schedule",
      "frost_thread",
      "sap_sketch"
    ],
    "item_instance_schema": {
      "id": "string",
      "charges": "integer|null",
      "sealed_by": "string|null",
      "bound_thread_id": "string|null",
      "tags": "string[]"
    }
  },
  "threads": {
    "description": "Active bargains / obligations",
    "schema": {
      "id": "string",
      "source": "sophia|ashen|briar|lior|market|law|other",
      "tags": [
        "Protection",
        "Pleasure",
        "Knowledge",
        "Time",
        "Freedom",
        "Name",
        "Body",
        "Service",
        "Silence",
        "Sovereignty"
      ],
      "terms_summary": "string",
      "status": ["active", "discharged", "broken", "transformed"],
      "can_cut_with": ["mirror_glass_knife", "law", "death", "sovereign_word"]
    },
    "known_thread_templates": [
      "obligation_gift_d1",
      "hospitality_dawn",
      "three_nights_or_truths",
      "ashen_service_owed",
      "ashen_clasp_double_edge",
      "briar_witness",
      "collar_property_scent"
    ]
  },
  "flags": {
    "description": "Boolean or enum story flags. Unlisted booleans default false.",
    "enums": {
      "entry_mode": ["guest", "claimed", "bargain", "refused", "dragged_guest"],
      "labyrinth_result": [
        "none",
        "devoted",
        "self",
        "peer_attempt",
        "blasphemy",
        "deep_ashen"
