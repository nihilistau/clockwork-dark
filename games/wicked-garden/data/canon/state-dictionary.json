  "codex_unlocks": {
    "type": "string[]",
    "examples": [
      "law_of_tens",
      "law_of_gifts",
      "law_of_names_partial",
      "law_hospitality",
      "gate_of_briars",
      "heart_grove",
      "sophia_partial",
      "ashen_vale",
      "thornwake",
      "lior",
      "mother_briar_partial",
      "elias",
      "root_crypts",
      "soft_century_hint",
      "feasting_glade",
      "thorn_labyrinth"
    ]
  },
  "ending": {
    "eligible": {
      "type": "string[]",
      "description": "Populated Day 8; subset of ending IDs"
    },
    "intent": { "$ref": "flags.enums.ending_intent" },
    "locked": { "$ref": "flags.enums.ending_locked" },
    "scores": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Soft weights E1..E6 for UI omens"
    },
    "selection_hints": {
      "E1a": ["day7_sophia_terms=will_discuss_leave|offers_equal_path", "favor_high", "not_stolen_force"],
      "E1b": ["active_bargain_or_paid_debt", "leave_law_or_key"],
      "E1c": ["forced_exit", "no_sophia_consent", "iron_or_stealth"],
      "E1d": ["time_debt_mortal_days >= 100"],
      "E2a": ["equality_seed >= 2", "favor >= 70", "autonomy >= 55", "shared_crisis_win"],
      "E2b": ["E2 gates", "abandon_seat_flag"],
      "E2c": ["E2 gates", "cost_visible_flag"],
      "E3a": ["favor >= 75", "autonomy <= 40", "desire >= 60", "thrall_consent"],
      "E3b": ["E3 gates", "public_seal"],
      "E3c": ["E3 gates", "autonomy <= 25"],
      "E4a": ["sophia_hunger_wrath", "refuse_exits"],
      "E4b": ["briar_claim"],
      "E4c": ["ashen_victory"],
      "E4d": ["public_feast_humiliation"],
      "E4e": ["player_opts_dissolution"],
      "E5a": ["usurp_gates", "spare_sophia"],
      "E5b": ["usurp_gates", "remove_sophia"],
      "E5c": ["briar_wins_through_player"],
      "E6a": ["ashen_route >= 2", "passport_or_service"],
      "E6b": ["lior_legion_flag"],
      "E6c": ["thornwake_squire_flag"],
      "E6d": ["market_true_debt"],
      "E6e": ["mara_arc_complete"]
    },
    "epilogue_card_pack": "docs/design/epilogues/EPILOGUE-CARDS.md"
  },
  "agent_contracts": {
    "gm_agent": {
      "may_write": [
        "meters.*",
        "flags.*",
        "clocks.*",
        "relationships.*(except sophia private mood)",
        "inventory",
        "threads",
        "location_key",
        "codex_unlocks",
        "ending.eligible",
        "ending.scores",
        "knowledge_partitions.gm_secrets",
        "knowledge_partitions.public_world",
        "knowledge_partitions.player_facing"
      ],
      "owns_voice": [
        "narration",
        "ashen_vale",
        "thornwake",
        "lior",
        "mother_briar",
        "elias",
        "mara_quill",
        "court",
        "bloomkin",
        "epilogue_card_m",
        "epilogue_card_g"
      ],
      "must_read_each_turn": [
        "meta",
        "meters",
        "flags",
        "clocks",
        "location_key",
        "inventory",
        "threads",
        "content.intensity",
        "content.boundaries"
      ]
    },
    "sophia_agent": {
      "may_write": [
        "meters.favor",
        "meters.desire",
        "meters.autonomy (with reason)",
        "meters.corruption (intimate/claim contexts)",
        "flags (sophia-related)",
        "relationships.sophia",
        "knowledge_partitions.sophia_private",
        "knowledge_partitions.public_world (limited)",
        "day7_sophia_terms"
      ],
      "owns_voice": ["sophia_dialogue", "sophia_intimate_direction", "sophia_echo_epilogue"],
      "must_not": [
        "override hard_nos",
        "set intensity above player",
        "speak as ashen/briar/thornwake",
        "reveal gm_secrets she does not know in-character",
        "unlock endings without system eligibility"
      ],
      "must_read_each_turn": [
        "meters",
        "flags related to claim/gift/jealousy",
        "player.boundaries",
        "content.intensity",
        "act2_compass",
        "relationships.sophia",
        "inventory gifts she gave"
      ],
      "mood_vector": {
        "type": "object",
        "properties": {
          "affection": { "type": "number", "min": 0, "max": 1 },
          "hunger": { "type": "number", "min": 0, "max": 1 },
          "jealousy": { "type": "number", "min": 0, "max": 1 },
          "playfulness": { "type": "number", "min": 0, "max": 1 },
          "melancholy": { "type": "number", "min": 0, "max": 1 },
          "wrath": { "type": "number", "min": 0, "max": 1 },
          "vulnerability": { "type": "number", "min": 0, "max": 1 }
        },
        "owner": "sophia_agent",
        "persistence": "session+summary"
      }
    },
    "system": {
      "owns": [
        "eligibility recompute",
        "day toll time_debt",
        "product safety gates",
        "act transitions",
        "ending lock validation"
      ]
    },
    "negotiation_rules": [
      "Product safety > all character goals",
      "If Sophia private scene and GM random event conflict: finish private, event becomes aftermath",
      "Threshold Law correctly invoked beats Sophia will for exit physics; she may still react on meters",
      "State board commit happens once per turn after negotiation",
      "Agents re-read board every turn; chat memory is not authoritative"
    ]
  },
  "turn_pipeline": [
    "player_input",
    "safety_filter",
    "intent_parse",
    "sophia_plan_if_present",
    "gm_plan",
    "negotiate",
    "state_commit",
    "render_prose",
    "render_choices",
    "image_brief",
    "video_brief_optional",
    "ending_check_soft"
  ],
  "image_brief_schema": {
    "shot_type": ["portrait", "wide", "intimate", "omen", "epilogue_card"],
    "subjects": "string[]",
    "location_key": "string",
    "mood_palette": "string",
    "wardrobe_state": "string",
    "key_action": "string",
    "ui_overlay_hint": "string",
    "content_level": ["suggestive", "explicit", "extreme"]
  },
  "video_brief_schema": {
    "duration_intent": [6, 10],
    "camera": "string",
    "motion_priority": "string[]",
    "start_frame_desc": "string",
    "emotional_payoff": "string"
  },
  "day_toll_default": {
    "time_debt_mortal_days_delta": 10,
    "on_labyrinth_lost_max": 10,
    "recompute": ["ending.scores", "clocks.mortal_collapse"]
  },
